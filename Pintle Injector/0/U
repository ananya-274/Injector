FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inletFuel
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.036/22;
        profile         turbulentBL;
        value           uniform (0 0 0);         
    }

    inletOxidiser
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.19/22;
        profile         turbulentBL;
        value           uniform (0 0 0);
    }
    
    walls
    {
        type            noSlip;
    }

    outlet
    {
        type                pressureInletOutletVelocity;
        tangentialVelocity  <field value>;
        value               <field value>;
        phi                 phi;

    }

    frontAndBack
    {
        type            empty;
    }
}


